# คัดลอกเป็น .env สำหรับรันในเครื่อง · บน Render ตั้งในเมนู Environment ของ Web Service

# ── Database (MariaDB เซิร์ฟเวอร์เดียวกับ VMS) ──
# ใช้ host เดียวกับระบบอื่นได้ แต่ DB_NAME ต้องเป็นของโปรเจกต์นี้เท่านั้น (ห้ามชี้ vms_mot)
# npm run migrate จะ CREATE DATABASE IF NOT EXISTS ให้เอง
DB_HOST=141.98.17.115
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=andamantech_crm

# ── Server ── (บน Render ไม่ต้องตั้ง PORT)
PORT=3000
NODE_ENV=development

# ── Auth ──
# production ที่ไม่ได้ตั้ง JWT_SECRET หรือ CRM_PIN → server ปฏิเสธการ start
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES=30d
CRM_PIN=change_me
